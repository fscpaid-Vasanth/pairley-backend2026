datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

// Legacy values (BOGO, BOGT, GROUP_DISCOUNT, BULK_PURCHASE, MEMBERSHIP_CAMPAIGN,
// PACKAGE_DEAL) are kept exactly as-is for backward compatibility — the "Legacy
// Mode" pair/group matching mechanic keeps working unchanged. All new offer
// creation should use the new mechanics below; STANDARD is the default.
enum OfferType {
  BOGO
  BOGT
  GROUP_DISCOUNT
  BULK_PURCHASE
  MEMBERSHIP_CAMPAIGN
  PACKAGE_DEAL
  STANDARD
  BUY_X_GET_Y
  FLAT_DISCOUNT
  PERCENTAGE_DISCOUNT
  CASHBACK
  COMBO
  SEASONAL
  FESTIVAL
  FLASH_DEAL
  LIMITED_QUANTITY
  LIMITED_TIME
}

// PAUSED/ARCHIVED are additive — nothing removed, existing rows/logic using
// the original 6 values are unaffected. CLOSED stays legacy-matching-only
// (never entered by STANDARD/new-mechanic offers).
enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
  CLOSED
  REJECTED
  PAUSED
  ARCHIVED
}

enum InterestStatus {
  INTERESTED
  READY_TO_BUY
  CONTACTED
  COMPLETED
  CANCELLED
}

// Module 5 — Lead Management. NEW is the default for every lead created by
// Show Interest (Module 3); the merchant progresses it from the Leads page.
enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  NOT_INTERESTED
}

// Lead-generation revision — which client the "Show Interest" click came
// from, so the admin lead dashboard can tell them apart. WEBSITE is the
// default (existing behavior, and the only client that existed before this
// enum); MOBILE_APP is set only by the Capacitor-wrapped native build,
// which can genuinely tell (Capacitor.isNativePlatform()), unlike a plain
// browser User-Agent check, which is trivially spoofable and was never a
// serious option.
enum LeadSource {
  WEBSITE
  MOBILE_APP
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// Claim/ownership lifecycle for a Business record — orthogonal to
// VerificationStatus (which tracks admin KYC approval). A normal, self-
// registered merchant is CLAIMED from creation (they proved phone/Google
// ownership at signup). UNCLAIMED is a business with no owner and no admin
// vouching for it. ADMIN_CURATED is also ownerless, but the admin created
// the record directly (bulk import) rather than it surfacing from
// discovery — so, unlike UNCLAIMED, it behaves like CLAIMED for every
// customer-facing purpose (offers visible, contact reveals after interest;
// see offerVisibility.ts's resolveContactAccess). Claiming only ever
// changes ownership/dashboard access, never customer-facing visibility —
// see claim-request.service.ts, which accepts a claim from either
// UNCLAIMED or ADMIN_CURATED and always lands on CLAIMED.
enum BusinessStatus {
  UNCLAIMED
  ADMIN_CURATED
  CLAIMED
  VERIFIED
  SUSPENDED
  REMOVED
}

// How a Business or Offer record originated. MANUAL covers self-service
// signup/offer-creation flows. WEBSITE/INSTAGRAM/FACEBOOK/GOOGLE/PDF/POSTER
// were populated by the AI Discovery Tool (Modules 9-11, 14), removed for
// the bulk-offer-import pivot — existing rows keep whatever value they were
// written with, but nothing writes these going forward. ADMIN is reserved
// for the upcoming Bulk Offer Import feature.
enum Source {
  MANUAL
  WEBSITE
  INSTAGRAM
  FACEBOOK
  GOOGLE
  PDF
  POSTER
  ADMIN
}

// Whether a merchant wants incoming leads (Show Interest) auto-accepted or
// held for manual review. Not wired into any lead-processing logic yet —
// that lands with the Show Interest / Lead Management modules.
enum LeadAcceptanceMode {
  MANUAL
  AUTOMATIC
}

// Module 14 Phase 3C — whose branding a generated offer banner leads with.
// PAIRLEY is the default and the only mode available to an UNCLAIMED
// business: a merchant who hasn't joined Pairley hasn't asked for their
// branding to be used, and putting their logo and colours front-and-centre
// on a Pairley-published banner would imply an endorsement that doesn't
// exist (the same reasoning that already withholds their logo entirely —
// see bannerLayout.ts's decideLogo). MERCHANT is honoured only once the
// business is CLAIMED, i.e. once a real merchant is making the choice.
enum BannerBrandingMode {
  PAIRLEY
  MERCHANT
}

// Module 11 — AI Offer Standardization & Enrichment. Tracks an Offer's
// enrichment lifecycle. Orphaned by the AI Discovery Tool removal — no code
// writes a new value anymore — kept rather than dropped since it's a plain,
// harmless historical field on existing rows (see Offer.enrichment_status).
// NOT_ENRICHED is the default for every offer, including every MANUAL
// (merchant self-service) offer, which was never a candidate for
// enrichment to begin with.
enum EnrichmentStatus {
  NOT_ENRICHED
  PENDING
  ENRICHED
  ENRICHMENT_FAILED
}

model Customer {
  id                  String             @id @default(uuid())
  name                String
  mobile              String             @unique
  email               String?            @unique
  password_hash       String?
  gender              String?
  date_of_birth       DateTime?
  age                 Int?
  city                String?
  state               String?
  address             String?
  pincode             String?
  profile_photo       String?
  referral_code       String?
  verification_status VerificationStatus @default(UNVERIFIED)

  // Module 6 — persisted notification preferences. Saved/retrieved only;
  // notificationService does not yet consult these on any send path
  // (deliberately out of scope for this module, per approved decision).
  notify_email    Boolean @default(true)
  notify_push     Boolean @default(true)
  notify_matching Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  interests    OfferInterest[]
  saved_offers SavedOffer[]
  ratings      Rating[]

  @@map("customers")
}

model Business {
  id                   String             @id @default(uuid())
  owner_name           String
  business_name        String
  business_type        String
  category             String
  mobile               String?            @unique // nullable as of Module 9: an AI-imported UNCLAIMED business may have no verified phone number yet — every existing self-registration path still always sets this
  email                String?            @unique // nullable: AI-imported businesses (Pairley 2.0) may have no known email
  password_hash        String? // Optional password for portal login
  address              String
  city                 String
  state                String
  pincode              String
  mall_name            String?
  aadhaar_number       String?
  aadhaar_photo        String?
  pan_number           String?
  pan_photo            String?
  gst_number           String?
  shop_photo           String?
  verification_status  VerificationStatus @default(PENDING)
  business_status      BusinessStatus     @default(UNCLAIMED) // explicitly set to CLAIMED at registration in code — see auth.service.ts
  source               Source             @default(MANUAL)
  created_by_ai        Boolean            @default(false)
  claimed_at           DateTime? // set only when an UNCLAIMED (AI-imported) business is claimed — null for normal signups
  claimed_by           String?
  subscription_id      String?
  notification_mobiles String?

  // Module 11 — AI-suggested merchant type, distinct from the existing
  // free-text business_type an admin/merchant can already set directly.
  // Advisory only; nothing reads this to gate behavior.
  suggested_merchant_type String?

  // Module 11 Phase 2 — business-level duplicate suggestions. Recommendation
  // only, exactly like the Offer-level fields: nothing here ever merges or
  // consolidates businesses automatically. Actual consolidation is a
  // Module 12 responsibility, once a merchant can verify ownership and
  // claim which business record is the real one.
  duplicate_of_business_id String?
  duplicate_score          Float?
  duplicate_reasons        String[]   @default([])
  duplicate_of             Business?  @relation("BusinessDuplicates", fields: [duplicate_of_business_id], references: [id], onDelete: SetNull)
  duplicates_of_this       Business[] @relation("BusinessDuplicates")

  // Module 12 Phase 4 — set only on the losing (REMOVED) side of a
  // confirmed admin consolidation. Deliberately separate from
  // duplicate_of_business_id above, which stays a pristine record of the
  // original AI suggestion (advisory, may never have been acted on) —
  // these three fields are the actual audit trail of what an admin did.
  consolidated_into_business_id String?
  consolidated_at               DateTime?
  consolidated_by               String? // admin id

  // Module 2: Business Profile
  logo                 String?
  cover_image          String?
  gallery_images       String[]           @default([])
  store_timing         Json? // { monday: { open, close, isClosed }, ... } — per-day hours, keyed by lowercase weekday
  geo_lat              Float?
  geo_lng              Float?
  lead_acceptance_mode LeadAcceptanceMode @default(MANUAL)

  // Module 14 Phase 3C — merchant banner branding preference. Additive and
  // defaulted, so every existing business keeps Pairley branding until a
  // merchant explicitly changes it. brand_color is a #RRGGBB hex string,
  // strictly validated before it reaches an SVG fill attribute (see
  // bannerBranding.ts) — never interpolated raw.
  banner_branding_mode BannerBrandingMode @default(PAIRLEY)
  brand_color          String?
  description          String?
  website              String?
  instagram            String?
  facebook             String?
  whatsapp             String?
  support_number       String?

  // Module 8 — WhatsApp Business API lead alerts (distinct from the public
  // storefront `whatsapp` field above). When null, code treats `mobile`
  // (already OTP-verified at registration) as the effective number AND as
  // verified — `lead_whatsapp_verified` only matters once a merchant sets
  // an explicit override here. See whatsapp.service.ts's
  // resolveLeadWhatsappNumber().
  lead_whatsapp_number   String?
  lead_whatsapp_verified Boolean @default(false)
  notify_whatsapp        Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscriptions  Subscription[]
  offers         Offer[]
  ratings        Rating[]
  claim_requests ClaimRequest[]

  @@map("businesses")
}

model Subscription {
  id                String             @id @default(uuid())
  business_id       String
  plan_name         String // Basic, Premium
  amount            Float
  start_date        DateTime
  expiry_date       DateTime
  status            SubscriptionStatus @default(PENDING)
  payment_reference String?
  created_at        DateTime           @default(now())

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Offer {
  id              String      @id @default(uuid())
  business_id     String
  title           String
  description     String
  offer_type      OfferType
  category        String
  original_price  Float
  offer_price     Float
  required_people Int
  joined_people   Int         @default(0)
  start_date      DateTime
  end_date        DateTime
  status          OfferStatus @default(DRAFT)
  source          Source      @default(MANUAL) // "offer_source" — reused from Module 1, shared with Business
  whatsapp_number String?

  // Legacy media — kept for migration compatibility, no longer written by new
  // code. Backfilled into cover_image/gallery_images at migration time.
  offer_image      String?
  facility_images  String[] @default([])
  facility_details String?

  // Module 3 media model — all new writes use these
  cover_image          String?
  gallery_images       String[] @default([])
  original_poster      String? // Pairley 2.0 — the raw imported poster, unused until Group B
  generated_offer_card String? // Pairley 2.0 — AI-generated card, unused until Group B

  // Location — offer coordinates override business coordinates when set;
  // otherwise the effective location is resolved as business.geo_lat/geo_lng
  // at the service layer (no geolocation logic duplicated here).
  geo_lat Float?
  geo_lng Float?

  // Pairley 2.0 preparation — schema only, no AI logic, unused until Group B.
  // Never exposed to customers (enforced at the API response layer, not here).
  confidence_score       Float?
  imported_at            DateTime?
  review_required        Boolean   @default(false)
  original_import_url    String?
  original_import_source String?
  merchant_verified      Boolean   @default(false)
  is_pairley_exclusive   Boolean   @default(false) // admin-only badge flag

  // Module 11 — canonical offer schema. subtitle/tags/keywords are additive
  // and empty/null until enrichment (Phase 3) populates them; the
  // normalization pipeline (Phase 1) does not touch these three.
  subtitle String? // short merchant-friendly tagline, distinct from title
  tags     String[] @default([]) // human-facing chips — admin-editable
  keywords String[] @default([]) // search-index terms, separate from tags
  // so search/ranking can evolve independently
  // of what's shown as chips in the UI

  // Enrichment audit trail. enrichment_confidence is a SEPARATE axis from
  // confidence_score above — confidence_score measures extraction
  // completeness (Module 9/10), enrichment_confidence measures how sure the
  // enrichment step is about its category/tag/type suggestions (Module 11).
  // enrichment_metadata carries, per suggested field: {suggested, accepted,
  // confidence, rationale} — the explainability trail Decision 6 requires.
  enrichment_status     EnrichmentStatus @default(NOT_ENRICHED)
  enrichment_confidence Float?
  enrichment_metadata   Json?

  // Duplicate detection (Module 11 Phase 2) — recommendation only, never
  // auto-merged (Decision 4). Always points at the earliest surviving
  // offer in a duplicate group, never at an intermediate one, so chains
  // stay flat. onDelete: SetNull — if the original is later removed, the
  // duplicate flag just clears rather than blocking or cascading the delete.
  duplicate_of_offer_id String?
  duplicate_score       Float?
  // Human-readable, generated once at detection time and persisted (not
  // recomputed on read) — an explainability snapshot of why this offer was
  // flagged, even if the compared-against offer later changes.
  duplicate_reasons     String[] @default([])
  duplicate_of          Offer?   @relation("OfferDuplicates", fields: [duplicate_of_offer_id], references: [id], onDelete: SetNull)
  duplicates_of_this    Offer[]  @relation("OfferDuplicates")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Bulk Offer Import — a short, human-typeable identifier every offer gets
  // (Postgres-native autoincrement, not just bulk-imported ones — simplest
  // to give every row one rather than conditionally assigning it). Purpose:
  // Bulk Image Upload matches uploaded files to offers by this number in
  // the filename (OFF000123.jpg), because asking an admin to name image
  // files after a UUID is unworkable. Display format is presentation-only
  // ('OFF' + zero-padded 6 digits) — the column itself stores the bare int
  // so matching logic (parse "OFF000123" -> 123) stays a trivial lookup.
  offer_code Int @unique @default(autoincrement())

  business  Business        @relation(fields: [business_id], references: [id], onDelete: Cascade)
  interests OfferInterest[]
  saved_by  SavedOffer[]
  versions  OfferVersion[]

  // Module 4 — supports a future raw-SQL bounding-box pre-filter for
  // geo/radius discovery queries; current listOffers() does the distance
  // pass in-memory on an already-narrowed (status/category-filtered) set,
  // but this index is in place for when catalog size makes that worth it.
  @@index([geo_lat, geo_lng])
  @@map("offers")
}

// Append-only history — every merchant edit, AI standardization, and admin
// moderation action snapshots the offer's prior state here before applying
// changes. Never used to overwrite anything; purely additive audit trail.
model OfferVersion {
  id          String   @id @default(uuid())
  offer_id    String
  version_no  Int
  snapshot    Json // full offer field snapshot immediately before this change
  changed_by  String? // business_id, or 'ADMIN', or 'AI_IMPORT'
  change_type String // CREATED | MERCHANT_EDIT | STATUS_CHANGE | ADMIN_MODERATION | AI_IMPORT | AI_STANDARDIZATION
  created_at  DateTime @default(now())

  offer Offer @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@map("offer_versions")
}

model OfferInterest {
  id          String         @id @default(uuid())
  offer_id    String
  customer_id String
  status      InterestStatus @default(INTERESTED)
  created_at  DateTime       @default(now())

  offer    Offer    @relation(fields: [offer_id], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@unique([offer_id, customer_id])
  @@map("offer_interests")
}

model SavedOffer {
  id          String   @id @default(uuid())
  customer_id String
  offer_id    String
  created_at  DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  offer    Offer    @relation(fields: [offer_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, offer_id])
  @@map("saved_offers")
}

model Notification {
  id                String   @id @default(uuid())
  user_id           String // Can link to Customer or Business ID
  title             String
  message           String
  notification_type String // New Offer, Partner Joined, Offer Completed, Subscription Expiry, etc.
  is_read           Boolean  @default(false)
  created_at        DateTime @default(now())

  @@map("notifications")
}

model Rating {
  id          String   @id @default(uuid())
  customer_id String
  business_id String
  rating      Int
  review      String?
  created_at  DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@unique([customer_id, business_id])
  @@map("ratings")
}

model SupportTicket {
  id          String        @id @default(uuid())
  user_id     String // Can link to Customer or Business ID
  subject     String
  description String
  status      SupportStatus @default(OPEN)
  created_at  DateTime      @default(now())

  @@map("support_tickets")
}

model Admin {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  name          String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("admins")
}

model OtpVerification {
  id         String   @id @default(uuid())
  mobile     String
  code       String
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("otp_verifications")
}

model CoBuyMessage {
  id               String   @id @default(uuid())
  deal_id          String
  sender_id        String
  sender_name      String
  text             String
  is_schedule_card Boolean  @default(false)
  day              String?
  time_slot        String?
  is_system        Boolean  @default(false)
  created_at       DateTime @default(now())

  @@map("co_buy_messages")
}

model Lead {
  id              String     @id @default(uuid())
  customer_id     String
  customer_name   String
  customer_mobile String
  offer_id        String
  offer_name      String
  shop_id         String
  shop_name       String
  created_at      DateTime   @default(now())
  // @default(now()) alongside @updatedAt: Prisma's @updatedAt alone is an
  // application-level behavior (auto-set on .update() calls), not a SQL
  // DEFAULT — `prisma db push` correctly refused to add a bare NOT NULL
  // column with no DB-level default against the 7 existing leads. The
  // explicit default backfills those rows safely; @updatedAt still keeps
  // updating it on every write going forward.
  updated_at      DateTime   @default(now()) @updatedAt
  status          LeadStatus @default(NEW)
  source          LeadSource @default(WEBSITE)

  // Module 13 — WhatsApp-free interest flow. Null = merchant hasn't
  // unlocked this lead's contact details yet; set once, on the merchant's
  // explicit "Unlock Customer Details" action (Phase 1: free, no quota —
  // see MERCHANT_LEAD_UNLOCK.md). Gates customer_mobile/name on both the
  // Leads list and the offer-details lead-status response.
  unlocked_at     DateTime?

  messages LeadMessage[]

  // No @relation fields on Lead itself by design — a lead is a standalone
  // record of a business's own history and must survive the customer/offer/
  // business rows it references being later deleted (see Module 4's
  // cleanup: leads do not cascade-delete with the customer, intentionally).
  // LeadMessage below is the one exception — a chat thread has no reason to
  // outlive the lead it belongs to, so it cascades with Lead specifically,
  // not with Customer/Offer/Business.
  //
  // @@unique replaces the old 24h-window soft duplicate check (see
  // OfferService.createLead) with a real DB-level guarantee: one lead per
  // customer per offer, permanently, matching Module 13's "customer should
  // never be able to submit interest multiple times for the same offer."
  @@unique([customer_id, offer_id])
  @@index([shop_id, status, created_at])
  @@map("leads")
}

// Module 13 — the 1:1 anonymous chat thread between a customer and the
// merchant, scoped to a single Lead. Deliberately separate from
// CoBuyMessage: that model backs the legacy BOGO/group-buy N-person pool
// chat (Offer.offer_type in LEGACY_MATCHING_OFFER_TYPES), a different
// feature (coordinating multiple buyers to meet capacity) left untouched by
// this module. This is a plain two-party thread — one Lead, one customer,
// one business, free text both directions.
model LeadMessage {
  id          String   @id @default(uuid())
  lead_id     String
  // Stored instead of a customer/business FK — the reader already knows
  // which lead (and therefore which two parties) this belongs to; all the
  // UI needs is which side of the conversation sent it, not who they are
  // (that's the whole point of the thread being anonymous).
  sender_role String // 'CUSTOMER' | 'BUSINESS'

  // Module 13 Phase 2 — Deal Coordination Assistant. `text` is always the
  // final, pre-rendered display string (e.g. "🕒 I will be available on 29
  // Jul 2026 at 5:30 PM") regardless of type, so the message feed never
  // needs type-specific rendering logic — new template types are additive
  // on the backend catalog (see leadMessageTemplates.ts) without touching
  // this model or the feed UI. `message_type`/`payload` exist for
  // structured templates that carry real data (SCHEDULE: date+time,
  // LOCATION: lat+lng for live sharing) — kept for potential future use
  // (e.g. a map preview) rather than required by anything today.
  //
  // Default 'STATEMENT' covers the free-text rows written before this
  // phase (2 in production, from the original chat implementation) — they
  // display exactly as before, just without a payload.
  message_type String @default("STATEMENT") // 'STATEMENT' | 'SCHEDULE' | 'LOCATION'
  text         String
  payload      Json?

  created_at DateTime @default(now())

  lead Lead @relation(fields: [lead_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at])
  @@map("lead_messages")
}

// Module 13 Phase 2 — durable event log behind every structured message
// sent in the Deal Coordination Assistant (see leadMessageTemplates.ts'
// analyticsEvents per template, and LeadService.sendMessage which writes
// these fire-and-forget, same non-blocking pattern as the WhatsApp/
// notification side-effects elsewhere in this file). Not read by anything
// today — this is deliberately just the durable log the roadmap's future
// analytics work will query, per the explicit "log every structured
// interaction for future analytics" requirement. No @relation to Lead, same
// reasoning as WhatsAppMessage.related_lead_id: a standalone log entry
// should survive independently of the lead it references.
model LeadInteractionEvent {
  id           String   @id @default(uuid())
  lead_id      String
  sender_role  String // 'CUSTOMER' | 'BUSINESS'
  template_key String // e.g. 'MEETING_WHEN', 'SCHEDULE_AVAILABLE_ON'
  event_type   String // e.g. 'MEETING_REQUESTED', 'DATE_SHARED', 'LOCATION_SHARED'
  created_at   DateTime @default(now())

  @@index([lead_id, created_at])
  @@index([event_type, created_at])
  @@map("lead_interaction_events")
}

model PushToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  platform   String // 'web', 'android', 'ios'
  created_at DateTime @default(now())

  @@map("push_tokens")
}

// Module 8 — WhatsApp Business API send log. Standalone/no @relation fields,
// matching Lead's precedent: a record of what was actually sent must survive
// the business/customer/lead rows it references being later deleted.
// v1 logs only SENT/FAILED — Meta's delivery/read-receipt webhook events are
// deliberately deferred (see Module 8 STEP 1 decision).
model WhatsAppMessage {
  id              String   @id @default(uuid())
  business_id     String?
  customer_id     String?
  direction       String // 'OUTBOUND' | 'INBOUND'
  template        String? // template name; null for the existing inbound bot replies
  to_number       String
  status          String // 'SENT' | 'FAILED'
  error           String?
  related_lead_id String?
  created_at      DateTime @default(now())

  @@index([business_id, created_at])
  @@map("whatsapp_messages")
}

// Module 9 Phase 4 — admin-assisted merchant claim flow for UNCLAIMED
// (AI-imported) businesses. PENDING_ADMIN_REVIEW -> ADMIN_APPROVED ->
// COMPLETED is the happy path; ADMIN_REJECTED and EXPIRED are terminal
// (EXPIRED also covers "too many failed OTP attempts" — see
// claim-request.service.ts). Every status transition is final except the
// initial PENDING_ADMIN_REVIEW -> ADMIN_APPROVED/ADMIN_REJECTED branch —
// once a token leaves ADMIN_APPROVED it can never be used again, which is
// the single-use/replay-protection mechanism, enforced in the service
// layer (not achievable via schema constraints alone).
enum ClaimRequestStatus {
  PENDING_ADMIN_REVIEW
  ADMIN_APPROVED
  ADMIN_REJECTED
  COMPLETED
  EXPIRED
}

model ClaimRequest {
  id               String             @id @default(uuid())
  business_id      String
  mobile           String
  claim_token      String             @unique
  status           ClaimRequestStatus @default(PENDING_ADMIN_REVIEW)
  token_expires_at DateTime
  otp_attempts     Int                @default(0)
  reviewed_by      String? // admin id
  reviewed_at      DateTime?
  rejection_reason String?
  completed_at     DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  // Module 12 Phase 1 — evidence-based self-service claims. Both additive;
  // a claim submitted before this module (or with no evidence supplied)
  // simply has claimant_name: null, evidence_urls: []. Deliberately a
  // flexible String[] rather than named fields (aadhaar_photo-style) —
  // claim evidence is plausibly a business registration certificate, a
  // storefront photo, a GST document, a rental agreement, etc., and
  // different merchants will have different combinations available.
  claimant_name String?
  evidence_urls String[] @default([])

  business Business @relation(fields: [business_id], references: [id], onDelete: Cascade)

  @@index([business_id, status])
  @@map("claim_requests")
}

// Bulk Offer Import — the Diwali-launch replacement for the AI Discovery
// Tool (Modules 9-11, 14, removed): offers are authored externally
// (ChatGPT/manual curation), uploaded as a spreadsheet, and published in
// bulk, with a separate Bulk Image Upload step matching image files to
// offers by Offer.offer_code. Absorbs what MODULE15_MERCHANT_OFFER_VALIDATION.md
// scoped (pricing-mode sanity checks, participant/discount validation) —
// that doc's concerns are now this feature's validation layer, not a
// separate future module.
// The batch moves through validation and offer-creation as two distinct,
// admin-triggered stages — not one "publish" — because images are attached
// to already-created DRAFT offers, before anything goes live. CREATING /
// CREATED cover "give every valid row a DRAFT business+offer and an
// offer_code"; PUBLISHING / COMPLETED cover the later, separate action that
// flips those DRAFT offers to ACTIVE once images are mapped and previewed.
enum BulkImportStatus {
  QUEUED
  VALIDATING
  VALIDATED
  CREATING
  CREATED
  PUBLISHING
  COMPLETED
  FAILED
}

// PENDING -> VALID/INVALID/DUPLICATE (validation) -> CREATED (a DRAFT
// business+offer exists) -> PUBLISHED (offer flipped to ACTIVE) is the happy
// path; FAILED covers a row that was VALID but errored during create/publish
// (e.g. a transient DB error) — distinct from INVALID (never had a chance)
// so a retry only reprocesses rows that are actually retryable.
enum BulkImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  CREATED
  PUBLISHED
  FAILED
}

// One row per image FILE inside an uploaded ZIP/multi-select — a different
// granularity from BulkImportRow, since one offer can have several image
// files. MISSING_OFFER: the parsed code matched no offer in this batch.
// DUPLICATE: that offer's slot (hero, or a given gallery position) was
// already filled by an earlier file in the same upload. INVALID_FILE: the
// filename didn't match the OFF<code>[_N].<ext> pattern at all.
enum BulkImageStatus {
  PENDING
  MAPPED
  MISSING_OFFER
  DUPLICATE
  INVALID_FILE
  UPLOADED
  FAILED
}

// One row per uploaded file (Excel/CSV offer sheet, or ZIP/multi-file image
// upload — the same batch record tracks both stages of one import, since an
// admin uploads offers first and images second against the same import).
// The total_*/valid_*/mapped_* counters are denormalized on purpose: they're
// what the Import History list and the Preview screen read, and recomputing
// them from BulkImportRow/BulkImportImage on every list-view render doesn't
// scale to 10,000+ rows. BulkImportScheduler is the only writer of these
// counts, incrementing them as it processes each row/image — never derived
// by a COUNT(*) query at read time.
model BulkImportBatch {
  id             String            @id @default(uuid())
  file_name      String
  file_url       String
  uploaded_by    String
  status         BulkImportStatus  @default(QUEUED)
  total_rows     Int               @default(0)
  valid_rows     Int               @default(0)
  invalid_rows   Int               @default(0)
  duplicate_rows Int               @default(0)
  created_rows   Int               @default(0) // VALID rows that now have a DRAFT business+offer — the CREATING-phase progress counter
  published_rows Int               @default(0)
  total_images   Int               @default(0)
  mapped_images  Int               @default(0)
  failed_images  Int               @default(0)
  error          String?
  started_at     DateTime?
  completed_at   DateTime?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  rows   BulkImportRow[]
  images BulkImportImage[]

  @@map("bulk_import_batches")
}

model BulkImportRow {
  id                   String              @id @default(uuid())
  batch_id             String
  row_no               Int
  raw_data             Json // the original row, for the downloadable error report
  // The validated, typed form of a VALID/DUPLICATE row — computed once by
  // validateBulkOfferRow() during createBatch() and never recomputed.
  // Draft-creation and publish both read this rather than re-validating
  // raw_data, so a row's outcome can't silently diverge from what the
  // admin saw in Preview.
  normalized           Json?
  status               BulkImportRowStatus @default(PENDING)
  errors               String[]            @default([])
  // Non-blocking flags on an otherwise VALID row (e.g. an unusually steep
  // discount) — kept separate from errors so the Preview screen can show
  // "ready to publish, but take a look at this" distinctly from "blocked".
  warnings             String[]            @default([])
  matched_business_id  String?
  created_offer_id     String?
  created_at           DateTime            @default(now())
  updated_at           DateTime            @updatedAt

  batch BulkImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id, status])
  @@map("bulk_import_rows")
}

model BulkImportImage {
  id               String          @id @default(uuid())
  batch_id         String
  file_name        String
  parsed_code      Int? // the numeric part of OFF000123.jpg — null if the filename didn't parse
  slot             Int? // 0 = hero, 1+ = gallery order — null for INVALID_FILE/MISSING_OFFER, which never resolve to a real slot
  matched_offer_id String?
  status           BulkImageStatus @default(PENDING)
  error            String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  batch BulkImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id, status])
  @@map("bulk_import_images")
}
